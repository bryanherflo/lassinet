# LassiNet service environment (copy to /etc/lassinet/lassinet.env, chmod 600)
# Never commit the real file. Replace every change-me value.

LASSI_MODE=live
LASSI_HOST=127.0.0.1
LASSI_PORT=8000

# REQUIRED for live: your authorized LAN. The service refuses any other subnet.
LASSI_LIVE_ALLOW=192.168.0.0/24

# Start with monitor-only. Set LASSI_DRY_RUN=1 to record/show blocks without
# enforcing them; remove it only after a review.
LASSI_DRY_RUN=1
LASSI_AUTO_BLOCK=0
LASSI_AUTO_BLOCK_SCOPE=external
LASSI_AUTO_BLOCK_TTL=3600

# Use mock for the first day; then opnsense (API) or the separate firewall
# helper. nftables/windows need root and are not enabled in this unit.
LASSI_FW=mock

# Named access; generate long random values (openssl rand -hex 32).
LASSI_TOKEN_OPERATOR=change-me-operator
LASSI_TOKEN_VIEWER=change-me-viewer
LASSI_SECRET=change-me-session-secret
LASSI_SESSION_TTL=43200

# Signed audit anchor; keep this key off the sensor in a password manager.
LASSI_CHECKPOINT_KEY=change-me-checkpoint-key

# Optional integrations.
# LASSI_TRIAGE_DB=data/triage.db
# LASSI_SURICATA_EVE=/var/log/suricata/eve.json
# LASSI_SURICATA_FROM_START=0
# LASSI_WEBHOOK_URL=https://hooks.slack.com/services/...
# LASSI_WEBHOOK_FORMAT=slack
# LASSI_WEBHOOK_MIN_SEVERITY=high
# LASSI_SENSOR_TOKEN=<shared-central-sensor-token>
# LASSI_PROXY_AUTH=1
# LASSI_PROXY_AUTH_SECRET=<shared-proxy-secret>
# LASSI_PROXY_AUTH_OPERATOR_GROUP=lassinet-operators
# LASSI_PROXY_AUTH_VIEWER_GROUP=lassinet-viewers
# LASSI_PROXY_AUTH_DEFAULT_ROLE=viewer
# LASSI_LOG_RETENTION_DAYS=30
# LASSI_LOG_KEEP=5
