# LassiNet configuration reference
#
# Copy this file to .env (never commit your real .env). Python-dotenv loads it
# at startup; exported environment variables take precedence.

# ---------- core ----------
LASSI_MODE=demo              # demo | live  (live needs `pip install scapy` + admin/root)
LASSI_AUTO_BLOCK=1           # 1 = auto-block high/critical sources (demo default), 0 = manual only
# LASSI_AUTO_BLOCK_SCOPE=external   # external | any - live default blocks only public sources
# LASSI_PROTECT=192.168.1.1,192.168.1.53   # addresses that must never be blocked (DNS/DHCP...)
LASSI_FW=mock                # mock | nftables | opnsense | windows | pfsense (placeholder)
#   On Windows, scripts\start-live-windows.ps1 asks for UAC and starts live with
#   LASSI_FW=windows: blocks become real inbound rules on this PC.
#   mock only records blocks in the dashboard (the header shows "simulated").
LASSI_HOST=127.0.0.1         # keep loopback unless you have auth in front of it
LASSI_PORT=8000              # dashboard port (python app.py --port 9000 also works)
# LASSI_TOKEN_OPERATOR=change-me-operator   # enables auth; can block/unblock/trust/rename
# LASSI_TOKEN_VIEWER=change-me-viewer       # read-only token (optional)
# LASSI_SECRET=random-string                # optional; stable cookie key across restarts
# LASSI_SESSION_TTL=43200                   # server-side session lifetime (seconds)
# LASSI_CAPTURE_FILTER=tcp or udp           # libpcap/BPF filter for live capture
# LASSI_LIVE_ALLOW=192.168.0.0/24          # live refuses any network outside this list
# LASSI_LIVE_ALLOW_ANY=1                   # NOT recommended: allow live on any LAN
# LASSI_PASSIVE=1                          # live observation only: no ARP/port probes
# LASSI_DRY_RUN=1                          # record/show blocks, enforce nothing
# LASSI_AUTO_BLOCK_TTL=3600                # auto-block expiry in seconds (0 = permanent)
# LASSI_IFACE=eth0            # live-mode capture interface (default: OS route)
# LASSI_NFT_CHAIN=lassinet_block   # nftables chain that holds the block rules
#   (must NOT be called "drop": that is a reserved word in the nft syntax)
# LASSI_DISCOVERY_INTERVAL=30  # live-mode ARP refresh seconds (0 = every tick)
# LASSI_DEVICE_TTL=1800       # forget a device not seen for this many seconds (0 = keep forever)
# LASSI_ALERT_DEDUPE=120      # identical detections share one card inside this window (0 = off)
# LASSI_LOG_MAX_BYTES=10485760  # rotate events.jsonl past this size in bytes (0 = never)
# LASSI_LOG_KEEP=5              # rotated archives to keep next to the log (0 = all)
# LASSI_LOG_RETENTION_DAYS=0   # delete rotated archives older than N days (0 = off)
# LASSI_LOGIN_MAX_ATTEMPTS=10  # failed logins per IP before 429
# LASSI_LOGIN_WINDOW=60       # sliding login window in seconds
# LASSI_CHECKPOINT_KEY=random-offbox-key   # signs audit checkpoints; keep it off-box
# LASSI_CHECKPOINT_FILE=data/audit_checkpoint.json
# LASSI_LOGFILE=logs/events.jsonl   # local JSONL event log (default path when unset)
# LASSI_BLOCKFILE=data/block_expiry.json   # persisted temporary-block expiry
# LASSI_NAMEFILE=data/device_names.json   # persisted device names (default when unset)
LASSI_TRUSTFILE=data/trusted_devices.json   # persisted trusted devices (default when unset)
# LASSI_DISMISSED_FILE=data/dismissed_alerts.json   # dismissed alert cards (the log keeps them)

# ---------- networks (everything adapts; these are only overrides) ----------
# LASSI_DEMO_NET=10.0.0.0/24     # base subnet for the simulated demo story (any CIDR)
# LASSI_SUBNET=192.168.1.0/24   # live-mode ARP sweep; auto-detected from this machine by default

# ---------- OPNsense provider (LASSI_FW=opnsense) ----------
# The alias must already exist (Host/Network/External) and be used by a
# firewall block rule. LassiNet only adds/removes addresses in it.
# OPNSENSE_URL=https://192.168.1.1
# OPNSENSE_KEY=your-api-key
# OPNSENSE_SECRET=your-api-secret
# OPNSENSE_ALIAS=lassinet_blocked
# OPNSENSE_VERIFY_TLS=1          # set 0 only for a lab with a self-signed cert
# OPNSENSE_TIMEOUT=5
#
# pfSense is still a placeholder: its REST API is different and not wired yet.
